DATABASE_URL=postgresql://user:password@localhost:5432/dbname
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_secure_secret
OPENROUTER_API_KEY=replace_with_openrouter_key
AI_MODEL=replace_with_ai_model_name
# Email (Gmail) – used to send interview invitations to candidates
# Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# AI Model Override (optional) — forces all AI tasks to use a single model
# If not set, the system uses smart routing: google/gemini-2.5-flash for all tasks
# AI_MODEL=google/gemini-2.5-flash
