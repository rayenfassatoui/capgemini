DATABASE_URL=postgresql://user:password@localhost:5432/dbname
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_secure_secret

# AI (LLM) — Required for AI agent
# Get an API key at https://build.nvidia.com/
# Uses NVIDIA Build API with stepfun-ai/step-3.5-flash model
NVIDIA_API_KEY=nvapi-your_nvidia_api_key

# AI Model Override (optional) — forces all AI tasks to use a single model
# If not set, the system uses stepfun-ai/step-3.5-flash for all tasks
# AI_MODEL=stepfun-ai/step-3.5-flash

# Email (Gmail) – used to send interview invitations to candidates
# Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
